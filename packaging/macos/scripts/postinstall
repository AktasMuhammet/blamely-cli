#!/bin/bash
#
# macOS .pkg postinstall — finish Blamely's PER-USER setup and show the report.
#
# The Installer runs this as root, but Blamely's daemon (a launchd LaunchAgent)
# and its git/AI-tool hooks live under the user's home (~/.blamely). So we resolve
# the human logged in at the GUI (the "console user") and run `blamely install` AS
# THAT USER (via `sudo -u`, non-root euid → install stays per-user).
#
# blamely writes its own step-by-step report (detected IDEs, installed plugins,
# git hooks, background agent) to ~/.blamely/last-install.log — NO shell
# redirection needed. The installer's conclusion pane (see build-macos.sh) points
# the user at that report, so this script opens no dialogs of its own.
#
# Best-effort: a failure here must never fail the package install (exit 0).

BLAMELY="/usr/local/bin/blamely"
log() { echo "blamely: $*"; }

CONSOLE_USER="$(/usr/bin/stat -f%Su /dev/console 2>/dev/null)"
case "$CONSOLE_USER" in
  ""|root|loginwindow|_mbsetupuser)
    log "no logged-in user (console user='${CONSOLE_USER:-none}'); skipping per-user setup."
    log "each user should run once:  blamely install"
    exit 0
    ;;
esac
if [ ! -x "$BLAMELY" ]; then
  log "error: $BLAMELY missing; cannot complete setup."
  exit 0
fi

USER_HOME="$(/usr/bin/dscl . -read "/Users/$CONSOLE_USER" NFSHomeDirectory 2>/dev/null | /usr/bin/awk '{print $2}')"
[ -n "$USER_HOME" ] || USER_HOME="/Users/$CONSOLE_USER"

log "configuring Blamely for user: $CONSOLE_USER"
# Run install as the user. NO_COLOR keeps /var/log/install.log clean; blamely also
# writes the same report to ~/.blamely/last-install.log.
/usr/bin/sudo -u "$CONSOLE_USER" -H /usr/bin/env NO_COLOR=1 "$BLAMELY" install
log "setup report: $USER_HOME/.blamely/last-install.log"

exit 0
